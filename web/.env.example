# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# 21st.dev registry API key — required for `npx shadcn@latest add @21st/<author>/<slug>`.
# Get one at https://21st.dev/mcp
API_KEY_21ST=

# Contact form (web/src/app/api/contact/route.ts) — Gmail SMTP via an app password.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=
